# the addresses the browser and the extension use (public ones: on the server, the domain). WEB_URL: the
# web app (Vite listens on its port in dev); the API sits behind its /api. API_URL: the API itself, its /api
# included, for the extension (built in at its build). API_PORT: the port the API listens on
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000/api
API_PORT=4000
# the JobPilot extension's id: the API lets it in (CORS), the web app talks to it. Comes from the key in
# apps/extension/wxt.config.ts, the extension's build checks they match
EXTENSION_ID=dakikehdmagghigijcpneocecnenklba

# signing in (Better Auth, Google only): Google sends the user back to WEB_URL/api/auth/callback/google,
# add it to the OAuth client's redirect URIs (console.cloud.google.com → APIs & Services → Credentials).
# BETTER_AUTH_SECRET signs the sessions: any long random string, e.g. openssl rand -base64 32; one of
# its own for each place the app runs
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host port 5433: a local Postgres already listens on 5432
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5433/jobpilot
REDIS_URL=redis://localhost:6379

WORKER_ROLE=local
SESSION_PRIVATE_KEY=

# worker: how often to read the job sites; what to look for there is picked in each user's profile
DISCOVER_EVERY_MINUTES=180

# a local worker only (WORKER_ROLE=local): the user whose job site sessions are on this machine
USER_EMAIL=you@example.com

# worker and API: the model that scores vacancies and fills the profile from the CV. claude-cli = the local Claude Code CLI on your subscription;
# gemini = Gemini API, free tier is enough (key: https://aistudio.google.com/apikey).
# LLM_MODEL is optional: sonnet / gemini-3.5-flash-lite by default.
LLM_PROVIDER=claude-cli
LLM_MODEL=
GEMINI_API_KEY=

# documents: any S3-compatible storage. Google Cloud Storage: endpoint https://storage.googleapis.com,
# HMAC keys from Cloud Storage → Settings → Interoperability (service account, role Storage Object User)
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=us-east1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
