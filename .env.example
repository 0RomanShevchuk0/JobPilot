API_PORT=4000

# Host port 5433: a local Postgres already listens on 5432
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5433/jobpilot
REDIS_URL=redis://localhost:6379

WORKER_ROLE=local
SESSION_PRIVATE_KEY=

# worker: how often to read the job sites; what to look for there is picked in each user's profile
DISCOVER_EVERY_MINUTES=180

# single-user mode until auth exists: the API acts as this user (created on startup)
USER_EMAIL=you@example.com

# worker and API: the model that scores vacancies and fills the profile from the CV. claude-cli = the local Claude Code CLI on your subscription;
# gemini = Gemini API, free tier is enough (key: https://aistudio.google.com/apikey).
# LLM_MODEL is optional: sonnet / gemini-3.5-flash-lite by default.
LLM_PROVIDER=claude-cli
LLM_MODEL=
GEMINI_API_KEY=

# documents: any S3-compatible storage. Google Cloud Storage: endpoint https://storage.googleapis.com,
# HMAC keys from Cloud Storage → Settings → Interoperability (service account, role Storage Object User)
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=us-east1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
