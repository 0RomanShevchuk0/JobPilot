{
   "name": "@jobpilot/worker",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "tsc && concurrently --kill-others --names tsc,worker --prefix-colors blue,magenta \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
      "build": "tsc",
      "start": "node dist/main.js",
      "discover:now": "tsc && node dist/discover-now.js",
      "vacancies:rebuild": "tsc && node dist/rebuild-vacancies.js",
      "postings:reparse": "tsc && node dist/reparse-postings.js",
      "matches:refresh": "tsc && node dist/refresh-matches.js",
      "djinni:login": "tsc && node dist/djinni-login.js",
      "djinni:read-form": "tsc && node dist/djinni-read-form.js",
      "typecheck": "tsc --noEmit"
   },
   "dependencies": {
      "@jobpilot/apply": "workspace:*",
      "@jobpilot/contracts": "workspace:*",
      "@jobpilot/db": "workspace:*",
      "@jobpilot/llm": "workspace:*",
      "@jobpilot/matching": "workspace:*",
      "@jobpilot/sources": "workspace:*",
      "@jobpilot/storage": "workspace:*",
      "@jobpilot/vacancies": "workspace:*",
      "bullmq": "^6.3.8",
      "ioredis": "^6.0.0",
      "playwright": "^1.63.0"
   },
   "devDependencies": {
      "@types/node": "^24.13.6",
      "concurrently": "^10.0.5",
      "typescript": "~6.0.3"
   }
}
