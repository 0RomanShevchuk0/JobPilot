# The server's one door: the web app's address (WEB_URL in .env, https://<domain>), its certificate
# from Let's Encrypt, got and renewed by Caddy. The browser sees one origin, so the sign-in cookie
# works without CORS, as through Vite's proxy in dev.
{$WEB_URL} {
	encode zstd gzip

	# the API's routes are under /api: passed on as they are
	handle /api/* {
		reverse_proxy api:{$API_PORT}
	}

	# the build's scripts and styles: their content's hash is in the name, a new build has new names,
	# so the browser keeps these for good and doesn't even ask again
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# the app's own routes (/matches, /applications/…) are index.html's, the router picks the page.
	# Asked again every time: after a deploy the browser takes the new one, with the new assets' names
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
