{
   "$schema": "https://turborepo.com/schema.json",
   // every package's dev task runs at once (tsc --watch, api, worker, web): room for all of them and more
   "concurrency": "20",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**"]
      },
      "typecheck": {
         "dependsOn": ["^build"]
      },
      "test": {
         "dependsOn": ["^build"]
      },
      "dev": {
         "dependsOn": ["^build"],
         "cache": false,
         "persistent": true
      }
   }
}
