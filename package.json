{
  "name": "jobpilot",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @jobpilot/db db:generate",
    "db:migrate": "pnpm --filter @jobpilot/db db:migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.0",
    "typescript": "~6.0.3"
  }
}
