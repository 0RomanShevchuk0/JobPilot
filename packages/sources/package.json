{
   "name": "@jobpilot/sources",
   "private": true,
   "type": "module",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "default": "./dist/index.js"
      },
      "./catalog": {
         "types": "./dist/catalog.d.ts",
         "default": "./dist/catalog.js"
      }
   },
   "scripts": {
      "build": "tsc -p tsconfig.build.json",
      "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
      "typecheck": "tsc",
      "test": "vitest run",
      "postinstall": "node scripts/install-browsers.js"
   },
   "dependencies": {
      "@jobpilot/contracts": "workspace:*",
      "cheerio": "^1.2.0",
      "domhandler": "^5.0.3",
      "fast-xml-parser": "^5.11.1",
      "libsodium-wrappers": "^0.8.4",
      "playwright": "^1.63.0",
      "turndown": "^7.2.4"
   },
   "devDependencies": {
      "@types/libsodium-wrappers": "^0.8.2",
      "@types/node": "^24.13.6",
      "@types/turndown": "^5.0.6",
      "typescript": "~6.0.3",
      "vitest": "^5.0.2"
   }
}
